# NCD Website — Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local with real secrets

# Public site URL used for canonical URLs, sitemap and Open Graph.
# DECISION NEEDED(D-23): production domain is not decided yet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key — SERVER ONLY, never expose to client
# Used for admin operations (user management, bypassing RLS)
# Get from Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here